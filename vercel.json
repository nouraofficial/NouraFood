{
  "rewrites": [
    {
      "source": "/store/:slug",
      "destination": "/store.html?v=:slug"
    },
    {
      "source": "/store/:slug/",
      "destination": "/store.html?v=:slug"
    },
    {
      "source": "/vendor",
      "destination": "/vendor.html"
    },
    {
      "source": "/vendor/",
      "destination": "/vendor.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw-vendor.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
